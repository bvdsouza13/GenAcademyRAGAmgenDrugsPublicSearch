# Server-side credentials only. Environment variables override non-empty file values.
PINECONE_API_KEY = ""
OPENAI_API_KEY = ""

# Hosted pilot sign-in (configure these through the private secrets file).
# The OIDC provider must return a verified email claim for administrator access.
[auth]
redirect_uri = "https://your-host/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "your-oidc-client-id"
client_secret = "your-oidc-client-secret"
server_metadata_url = "https://your-identity-provider/.well-known/openid-configuration"

# Add ADMIN_EMAILS as a Replit Secret: comma-separated, verified administrator
# email addresses. Do not commit a populated secrets.toml file.
