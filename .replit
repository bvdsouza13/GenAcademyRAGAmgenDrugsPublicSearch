modules = ["python-3.12", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "cacert", "cargo", "freetype", "glibcLocales", "grpc", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libffi", "libiconv", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "libyaml", "mupdf", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "swig", "tcl", "tk", "xcbuild", "xcodebuild", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m streamlit run app.py --server.address 0.0.0.0 --server.port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6000
externalPort = 6000

[deployment]
deploymentTarget = "autoscale"
run = ["python", "scripts/start_streamlit.py"]

[objectStorage]
defaultBucketID = "replit-objstore-ed1b5add-8303-4ce8-bc57-0885b20efe94"

[userenv]

[userenv.shared]
AMGEN_STORAGE_BACKEND = "app_storage"

[userenv.production]
AMGEN_APP_MODE = "hosted"
AUTH_REDIRECT_URI = "https://gen-academy-rag-amgen-drugs-public-search.replit.app/oauth2callback"
